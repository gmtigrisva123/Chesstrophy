# Normalise line endings so Windows checkouts do not produce noisy diffs.
* text=auto eol=lf

# Binary assets — never diff or attempt to merge.
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.webp   binary
*.ico    binary
*.woff   binary
*.woff2  binary
*.pdf    binary

# Keep generated files out of diffs and language statistics.
package-lock.json  -diff linguist-generated=true
dist/**            linguist-generated=true
legacy/**          linguist-vendored=true
