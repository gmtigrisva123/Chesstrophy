# ─────────────────────────────────────────────────────────────────────────────
# ChessProphy — environment
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to `.env.local` and fill in the blanks:
#
#     cp .env.example .env.local
#
# `.env*` is gitignored except this template, so `.env.local` with your real
# values is never committed. Every line marked "e.g." shows the SHAPE of the
# value, not a working key — replace it with your own.
#
# Rule of thumb:
#   • VITE_*  → shipped to the browser. Safe to be public (see note by each).
#   • no VITE_ prefix → server / CLI only. Keep secret. Never rename to VITE_*.
# ─────────────────────────────────────────────────────────────────────────────


# ═══════════════════════════════════════════════════════════════════════════
#  WHAT TO CREATE A REAL STUDENT DATABASE  (do this once)
# ═══════════════════════════════════════════════════════════════════════════
#
#   1. Create a project at https://supabase.com/dashboard  → you now have a
#      Project URL, an anon key, and a database password you chose.
#   2. Fill in GROUP A below (URL + anon key)  → the app can talk to it.
#   3. Fill in GROUP B below (ref + access token + db password) and run:
#          supabase link --project-ref "$SUPABASE_PROJECT_REF"
#          supabase db push
#      → your 48 tables, RLS policies and seed data are now in the real DB.
#   4. Students can sign up. To make yourself admin, see GROUP C.
#
# Full walkthrough + pre-launch checklist: supabase/README.md → "Deploying"


# ═══ GROUP A · App connection (REQUIRED to run against the real DB) ═════════
#
# Dashboard → Project Settings → API.
# Local stack instead? Run `supabase start` and use the values it prints.

# The project's REST endpoint. Just the origin, no trailing slash.
#   e.g.  VITE_SUPABASE_URL=https://abcd1234efgh5678ijkl.supabase.co
VITE_SUPABASE_URL=

# The "anon" / publishable key. PUBLIC by design — it only identifies the
# project; row level security decides what each request may actually read.
# It is a long JWT (starts with "eyJ", ~200+ chars) or an "sb_publishable_" key.
#   e.g.  VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiYW5vbiJ9.REPLACE_ME
VITE_SUPABASE_ANON_KEY=


# ═══ GROUP B · Schema deployment (REQUIRED once, to create/update tables) ═══
#
# The Supabase CLI reads these from your SHELL, not from .env.local. Either
# `export` them, or load this file first:  set -a; . ./.env.local; set +a

# Project ref = the sub-domain in your Project URL, and Settings → General.
# 20 lowercase letters/digits.
#   e.g.  SUPABASE_PROJECT_REF=abcd1234efgh5678ijkl
SUPABASE_PROJECT_REF=

# Personal access token for the CLI: Dashboard → Account → Access Tokens →
# "Generate new token". Starts with "sbp_". Treat it like your password.
#   e.g.  SUPABASE_ACCESS_TOKEN=sbp_<40 hex characters>
SUPABASE_ACCESS_TOKEN=

# The database password you set when creating the project (reset it at
# Settings → Database → "Database password" if you forgot it). Needed for a
# non-interactive `supabase db push`.
#   e.g.  SUPABASE_DB_PASSWORD=Str0ng-Passphrase-You-Chose
SUPABASE_DB_PASSWORD=

# Optional — only for tools that hit Postgres directly (psql, backups).
# Settings → Database → Connection string → URI. Has the password inline.
#   e.g.  SUPABASE_DB_URL=postgresql://postgres:Str0ng-Passphrase-You-Chose@db.abcd1234efgh5678ijkl.supabase.co:5432/postgres
SUPABASE_DB_URL=


# ═══ GROUP C · Admin key (OPTIONAL — bypasses ALL row level security) ══════
#
# Dashboard → Project Settings → API → "service_role" (or an "sb_secret_" key).
# Use ONLY for trusted server-side admin work that must ignore RLS — e.g. a
# one-off script that grants the first admin:
#
#     insert into public.user_roles (user_id, role)
#     values ('<your-auth-uid>', 'admin');
#
# (You can also just run that in the dashboard SQL editor and skip this key.)
#
# NEVER rename this to VITE_*, put it in browser code, or commit it. If it
# leaks, rotate it on the same API settings page immediately.
#   e.g.  SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoic2VydmljZV9yb2xlIn0.REPLACE_ME
SUPABASE_SERVICE_ROLE_KEY=


# ═══ Dashboard settings students depend on (set these in the web console) ══
#
# `supabase/config.toml` only configures the LOCAL stack. On the hosted
# project, before students sign in:
#   • Auth → Providers → Email → turn ON "Confirm email"
#   • Auth → URL Configuration → set Site URL + redirect URLs to your domain
#   • Auth → decide if anonymous ("Continue as Guest") sign-ins stay enabled
#   • Auth → Rate Limits and password policy — review
#   • Database → enable Point-in-Time Recovery, then rehearse a restore


# ── Dev server (optional) ────────────────────────────────────────────────────
# Port for `npm run dev` / `npm run preview`. Default 5173 / 4173.
#   e.g.  PORT=3000
# PORT=5173
