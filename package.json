{
  "name": "chessprophy",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "ChessProphy — an AI-assisted chess learning platform: opening trainer, courses, puzzles, coaching, and a personalised learning tree.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:reset": "supabase db reset",
    "db:diff": "supabase db diff -f",
    "db:push": "supabase db push",
    "db:lint": "node scripts/lint-supabase-sql.mjs",
    "db:test": "supabase test db",
    "db:types": "supabase gen types typescript --local > src/lib/supabase/database.types.ts",
    "db:seed:generate": "node scripts/generate-supabase-seed.mjs",
    "db:seed:check": "node scripts/generate-supabase-seed.mjs --check",
    "typecheck": "tsc --noEmit",
    "analyze": "vite build && node scripts/report-bundle-size.mjs",
    "verify": "npm run lint && npm run typecheck && npm run db:lint && npm run db:seed:check && npm run test && npm run build",
    "prepare": "husky || true"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.9",
    "@vitest/ui": "^2.1.9",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.15.0",
    "husky": "^9.1.7",
    "jsdom": "^25.0.1",
    "lint-staged": "^15.5.2",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.9"
  },
  "keywords": [
    "chess",
    "education",
    "react",
    "vite",
    "puzzles",
    "openings",
    "learning-platform"
  ],
  "license": "MIT",
  "homepage": "https://github.com/gmtigrisva123/Chesstrophy#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gmtigrisva123/Chesstrophy.git"
  },
  "bugs": {
    "url": "https://github.com/gmtigrisva123/Chesstrophy/issues"
  },
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=10"
  }
}
